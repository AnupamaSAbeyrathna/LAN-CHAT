{
    "name": "lan-chat",
    "version": "1.0.0",
    "description": "CLI-based peer-to-peer chat app for local WiFi networks",
    "main": "src/index.js",
    "type": "module",
    "bin": {
        "lan-chat": "src/index.js"
    },
    "scripts": {
        "start": "node src/index.js",
        "start:alice": "node src/index.js --name Alice",
        "start:bob": "node src/index.js --name Bob --port 9002",
        "matrix": "node src/index.js --name Neo",
        "ghost": "node src/index.js --name Ghost"
    },
    "keywords": [
        "chat",
        "lan",
        "cli",
        "p2p"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "chalk": "^5.3.0"
    }
}